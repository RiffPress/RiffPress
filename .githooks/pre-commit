#!/usr/bin/env bash
# Runs before every commit: lint, then a fast Playwright smoke pass against the local wp-env. CI still
# runs the full suite on the pull request.
# Skip the suite for a commit with RIFF_SKIP_E2E=1, or everything with git commit --no-verify.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

# A worktree gets the main checkout's node_modules and its own vendor, so the lint runs.
WORKTREE=
if [[ "$(git rev-parse --git-dir)" != "$(git rev-parse --git-common-dir)" ]]; then
	WORKTREE=1
	node scripts/worktree.js setup >/dev/null
fi

echo "pre-commit: lint"
npm run -s lint
echo "pre-commit: hooks reference"
npm run -s docs:hooks:check || { echo "pre-commit: run npm run docs"; exit 1; }
echo "pre-commit: JavaScript reference"
npm run -s docs:js:check || { echo "pre-commit: run npm run docs"; exit 1; }
echo "pre-commit: PHP, REST and CSS references"
npm run -s docs:reference:check
echo "pre-commit: handbooks"
npm run -s docs:handbook:check
echo "pre-commit: web pages"
npm run -s docs:web:check
echo "pre-commit: site navigation"
npm run -s docs:nav:check
echo "pre-commit: readme.txt changelogs"
npm run -s docs:changelog:check
# The rest of what CI's docs job checks, so a commit this passes passes there too
# (.github/scripts/pre-commit.test.js keeps the two lists the same).
echo "pre-commit: isolation.json"
node .github/scripts/isolation.js --check
echo "pre-commit: TypeScript types"
npm run -s types:check || { echo "pre-commit: run npm run types"; exit 1; }
echo "pre-commit: versions"
node .github/scripts/release-check.js tree
echo "pre-commit: the workflow scripts' tests"
# site/web is built, not committed, and the tests read its pages, as in their workflow.
node .github/scripts/web-pages.js >/dev/null
node --test --test-reporter=dot .github/scripts/*.test.js

if [[ -n "${RIFF_SKIP_E2E:-}" ]]; then
	echo "pre-commit: RIFF_SKIP_E2E set, skipping the Playwright suite"
	exit 0
fi

# A worktree's suite runs against its own site, never the main checkout's, which serves another
# branch's code.
if [[ -n "$WORKTREE" && ! -f .wp-env.override.json ]]; then
	echo "pre-commit: this worktree has no site of its own yet: npm run wt -- env, then commit again."
	echo "           RIFF_SKIP_E2E=1 commits without the suite, for docs and site changes only."
	exit 1
fi

PORT=$(node -e 'try { console.log( require( "./.wp-env.override.json" ).testsPort || 8891 ) } catch { console.log( 8891 ) }')
if ! curl -sf -o /dev/null "http://localhost:${PORT}/"; then
	echo "pre-commit: the wp-env tests site is not answering on port ${PORT}."
	if [[ -n "$WORKTREE" ]]; then
		echo "           This worktree has a site of its own: npm run wt -- env, then commit again."
	else
		echo "           npm run env:start, then commit again."
	fi
	echo "           RIFF_SKIP_E2E=1 commits without the suite, for docs and site changes only."
	exit 1
fi

echo "pre-commit: Playwright smoke tests against http://localhost:${PORT}"
# A test must fail twice to stop the commit, as CI retries too (wp-scripts' config): on a laptop
# that is busy with other work, the player's timed tests now and then miss a beat that has
# nothing to do with the change, while a real failure fails again.
WP_BASE_URL="http://localhost:${PORT}" npx wp-scripts test-playwright plugins/riff/tests/e2e/player/ --project=chromium --reporter=line --retries=1
