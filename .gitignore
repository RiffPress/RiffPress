vendor/
node_modules/
# A worktree links these to the main checkout's (npm run wt), and a link is not a folder to the rules above.
/vendor
/node_modules
# Worktrees made by npm run wt and by Claude Code, and Claude Code's own per-person settings.
/.claude/worktrees/
/.claude/settings.local.json
build/
artifacts/
test-results/
playwright-report/
.phpcs.cache
.wp-env.override.json
plugin-check.json
*.zip
.DS_Store

# scratch output must never land in the package
undefined/
*.png
!assets/*.png
!site/*.png
!site/brand/*.png
!site/icons/*.png
!site/covers/*.png
!site/og/*.png
!plugins/riff/features/listen/icons/*.png
# Generated at build time by npm run pot; translations come from translate.wordpress.org.
plugins/riff/languages/
!tests/fixtures/**/*.png
# Built by npm run docs:hooks, and by the Pages deploy from the commit it publishes: each page quotes the
# line its hook fires on, so a committed copy would go stale with any edit above it.
/site/developers/hooks/
/site/developers/javascript/
/site/developers/php/
/site/developers/rest/
/site/developers/css/
/site/developers/player/
/site/developers/extensions/
/site/developers/music/
/site/developers/album/
/site/developers/post/
/site/developers/listen-page/
/site/developers/app/
/site/developers/lyrics/
/site/developers/sign-in/
/site/developers/rights/
/site/developers/network/
/site/developers/track/
/site/developers/isolation/
/site/developers/verify/
/site/developers/contributing/
/site/developers/native/
# The Build on Riff door is written by hand, though build/ is ignored everywhere else.
!/site/developers/build/
# Built by npm run docs:web, and by the Pages deploy, for the same reason: each page links the lines it
# quotes. Only its data, its stylesheet and the sitemap are committed.
/site/web/*
!/site/web/web.json
!/site/web/web.css
# Written by .github/scripts/detect-public-surface.js when run locally.
comment.md

# WordPress writes its intermediate sizes next to the fixture artwork whenever a site imports it, and
# those are output, not fixtures.
packages/fixtures/*/cover-[0-9]*x[0-9]*.png
# A streamed album's audio, built by `npm run albums`: the deploy builds its own.
packages/fixtures/*/audio/

# The old fixture mapping. On some machines a personal music library still lives here; it is never
# part of the repository.
/tests/

# The directory listing's banner, icons and screenshots are made by npm run docs:wporg and committed.
!/.wordpress-org/*.png
.phpunit.result.cache

# Built from site/src by .github/scripts/site-js.js when the site deploys.
site/js/
