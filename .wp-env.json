{
  "core": "https://wordpress.org/wordpress-7.2-beta3.zip",
  "phpVersion": "8.2",
  "plugins": [
    "./plugins/riff",
    "./plugins/riff-lyrics",
    "./plugins/riff-chords",
    "./plugins/riff-sign-in",
    "./plugins/riff-sing",
    "https://github.com/WordPress/presence-api/releases/download/v0.20.0/presence-api.zip",
    "https://github.com/WordPress/presence-api/releases/download/v0.20.0/presence-scenes.zip"
  ],
  "port": 8890,
  "testsPort": 8891,
  "mappings": {
    "wp-content/riff": "."
  },
  "config": {
    "WP_DEBUG": true,
    "SCRIPT_DEBUG": true,
    "WP_ENVIRONMENT_TYPE": "local"
  },
  "lifecycleScripts": {
    "afterStart": "npx wp-env run cli wp rewrite structure '/%postname%/' --hard >/dev/null && npx wp-env run tests-cli wp rewrite structure '/%postname%/' --hard >/dev/null"
  },
  "env": {
    "development": {
      "mappings": {
        "wp-content/mu-plugins": "./packages/dev"
      }
    },
    "tests": {
      "plugins": [
        "./plugins/riff",
        "./plugins/riff-lyrics",
        "./plugins/riff-chords",
        "./plugins/riff-sign-in",
        "./plugins/riff-sing",
        "https://github.com/WordPress/presence-api/releases/download/v0.20.0/presence-api.zip",
        "https://github.com/WordPress/presence-api/releases/download/v0.20.0/presence-scenes.zip",
        "./plugins/riff/tests/components"
      ]
    }
  }
}
