{
  "$schema": "https://playground.wordpress.net/blueprint-schema.json",
  "preferredVersions": {
    "php": "8.3",
    "wp": "latest"
  },
  "landingPage": "/compositions/",
  "login": true,
  "steps": [
    {
      "step": "setSiteOptions",
      "options": {
        "blogname": "Riff",
        "permalink_structure": "/%postname%/"
      }
    },
    {
      "step": "installPlugin",
      "pluginData": {
        "resource": "url",
        "url": "riff.zip"
      }
    },
    {
      "step": "mkdir",
      "path": "/wordpress/wp-content/riff-demo/compositions"
    },
    {
      "step": "writeFile",
      "path": "/wordpress/wp-content/riff-demo/seed.php",
      "data": {
        "resource": "url",
        "url": "demo/seed.php"
      }
    },
    {
      "step": "writeFile",
      "path": "/wordpress/wp-content/riff-demo/compositions/manifest.json",
      "data": {
        "resource": "url",
        "url": "demo/manifest.json"
      }
    },
    {
      "step": "writeFile",
