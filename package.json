{
  "name": "riff-monorepo",
  "version": "4.29.0",
  "description": "Riff, a music player for WordPress, with its fixtures and test tooling.",
  "license": "GPL-2.0-or-later",
  "private": true,
  "workspaces": [
    "plugins/*",
    "packages/*"
  ],
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "postinstall": "node .github/scripts/patch-wp-env.js",
    "env:start": "wp-env start",
    "env:stop": "wp-env stop",
    "env:clean": "wp-env clean all",
    "desktop": "node packages/desktop/scripts/dev.js",
    "seed": "wp-env run cli wp eval-file wp-content/riff/packages/fixtures/seed.php",
    "seed:tests": "wp-env run tests-cli wp eval-file wp-content/riff/packages/fixtures/seed.php",
    "lint": "npm run lint:php && npm run lint:js && npm run lint:css",
    "lint:php": "composer lint",
    "lint:js": "wp-scripts lint-js plugins packages",
    "lint:css": "wp-scripts lint-style 'plugins/**/*.css' 'site/**/*.css'",
    "format:js": "wp-scripts format plugins packages",
    "test:e2e": "wp-scripts test-playwright",
    "test:e2e:ui": "wp-scripts test-playwright --ui",
    "test:php": "wp-env run tests-wordpress --env-cwd=wp-content/riff ./vendor/bin/phpunit",
    "test:php:multisite": "wp-env run tests-wordpress --env-cwd=wp-content/riff env WP_TESTS_MULTISITE=1 ./vendor/bin/phpunit",
    "plugin-zip": "npm run plugin-zip --workspace=plugins/riff",
    "pot": "wp-env run cli wp i18n make-pot wp-content/plugins/riff wp-content/plugins/riff/languages/riff.pot --domain=riff --no-location --exclude=tests,node_modules --package-name=Riff",
    "api-coverage": "node packages/wp-api-coverage/bin/wp-api-coverage.js plugins/riff",
    "docs": "npm run -s docs:hooks && npm run -s docs:js && npm run -s docs:reference && npm run -s docs:web",
    "docs:hooks": "node .github/scripts/hooks-reference.js",
    "docs:hooks:check": "node .github/scripts/hooks-reference.js --check",
    "docs:js": "node .github/scripts/js-reference.js",
    "docs:js:check": "node .github/scripts/js-reference.js --check",
    "docs:reference": "node .github/scripts/reference-pages.js",
    "docs:reference:check": "node .github/scripts/reference-pages.js --check",
    "docs:web": "node .github/scripts/web-pages.js",
    "docs:web:check": "node .github/scripts/web-pages.js --check",
    "docs:changelog": "node .github/scripts/readme-changelog.js",
    "docs:og": "node .github/scripts/og-images.js",
    "docs:changelog:check": "node .github/scripts/readme-changelog.js --check"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.47.0",
    "@wordpress/e2e-test-utils-playwright": "^2.1.0",
    "@wordpress/env": "^11.16.0",
    "@wordpress/scripts": "^36.1.0",
    "globals": "^17.13.0"
  },
  "homepage": "https://riffpress.com/",
  "repository": {
    "type": "git",
    "url": "https://github.com/RiffPress/RiffPress.git"
  },
  "bugs": {
    "url": "https://github.com/RiffPress/RiffPress/issues"
  },
  "overrides": {
    "js-yaml": "^5.4.3",
    "postcss-selector-parser": "^7.1.6",
    "smol-toml": "^1.9.1",
    "katex": "^0.19.0",
    "serialize-javascript": "^7.1.2",
    "qs": "^6.16.0",
    "uuid": "^11.1.1",
    "simple-git": "^4.0.2"
  }
}
