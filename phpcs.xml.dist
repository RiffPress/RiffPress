<?xml version="1.0"?>
<ruleset name="Riff">
	<description>WordPress Coding Standards for Riff.</description>
	<file>plugins</file>
	<file>packages</file>
	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>
	<!-- Fixture plugins the API coverage scanner reads in its tests; they exist to be scanned, not run. -->
	<exclude-pattern>/packages/wp-api-coverage/test/fixtures/*</exclude-pattern>
	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="sp"/>
	<config name="minimum_wp_version" value="6.5"/>
	<config name="testVersion" value="8.1-"/>
	<rule ref="WordPress">
		<exclude name="Universal.Arrays.DisallowShortArraySyntax"/>
	</rule>
	<!--
		Every string Riff shows is in the riff text domain, so translate.wordpress.org picks it up. Riff
		Lyrics is a separate plugin and sets its own domain at the top of its file with phpcs:set.
		.github/scripts/text-domain-check.sh shows this catches a wrong or missing domain.
	-->
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array"><element value="riff"/></property>
		</properties>
	</rule>
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array"><element value="riff"/><element value="Riff"/></property>
		</properties>
	</rule>
	<rule ref="PHPCompatibilityWP"/>

	<!--
		Isolation (docs/isolation.md): the primitives no plugin here uses without saying why. The
		WordPress standard already fails eval() (Squiz.PHP.Eval), create_function()
		(WordPress.PHP.RestrictedPHPFunctions), extract() (WordPress.PHP.DontExtract) and SQL built
		without $wpdb->prepare() (WordPress.DB.PreparedSQL); these make its warnings about running a
		program and unserializing errors, each saying what to do instead.
		.github/scripts/isolation.js checks the rest against each plugin's isolation.json.
	-->
	<rule ref="WordPress.PHP.DiscouragedPHPFunctions.system_calls_exec">
		<type>error</type>
		<message>%s() runs a program through a shell. Do it in PHP, or declare the program in isolation.json "spawn", escape every argument, and say why on the line: // isolation: spawn -- why (docs/isolation.md).</message>
	</rule>
	<rule ref="WordPress.PHP.DiscouragedPHPFunctions.system_calls_shell_exec">
		<type>error</type>
		<message>%s() runs a program through a shell. Do it in PHP, or declare the program in isolation.json "spawn", escape every argument, and say why on the line: // isolation: spawn -- why (docs/isolation.md).</message>
	</rule>
	<rule ref="WordPress.PHP.DiscouragedPHPFunctions.system_calls_system">
		<type>error</type>
		<message>%s() runs a program through a shell. Do it in PHP, or use exec() with a declared program (docs/isolation.md).</message>
	</rule>
	<rule ref="WordPress.PHP.DiscouragedPHPFunctions.system_calls_passthru">
		<type>error</type>
		<message>%s() runs a program through a shell. Do it in PHP, or use exec() with a declared program (docs/isolation.md).</message>
	</rule>
	<rule ref="WordPress.PHP.DiscouragedPHPFunctions.system_calls_proc_open">
		<type>error</type>
		<message>%s() runs a program. Do it in PHP, or use exec() with a declared program (docs/isolation.md).</message>
	</rule>
	<rule ref="WordPress.PHP.DiscouragedPHPFunctions.system_calls_popen">
		<type>error</type>
		<message>%s() runs a program. Do it in PHP, or use exec() with a declared program (docs/isolation.md).</message>
	</rule>
	<rule ref="WordPress.PHP.DiscouragedPHPFunctions.serialize_unserialize">
		<type>error</type>
		<message>%s() can build any object from its input. Store JSON and read it with json_decode(), or let WordPress's own option and meta functions do it (docs/isolation.md).</message>
	</rule>

	<!--
		Tests are held to the same code style, but not to the same documentation rules: a test's name is
		its description, and a docblock repeating it in prose is noise. The file-name and filesystem rules
		go too, because `test-*.php` is PHPUnit's convention and a test that writes a fixture archive has
		no business standing up WP_Filesystem to do it.
	-->
	<rule ref="Squiz.Commenting.FunctionComment.Missing">
		<exclude-pattern>/tests/php/*</exclude-pattern>
	</rule>
	<rule ref="Squiz.Commenting.FunctionComment.MissingParamTag">
		<exclude-pattern>/tests/php/*</exclude-pattern>
	</rule>
	<rule ref="Squiz.Commenting.ClassComment.Missing">
		<exclude-pattern>/tests/php/*</exclude-pattern>
	</rule>
	<rule ref="Squiz.Commenting.VariableComment.Missing">
		<exclude-pattern>/tests/php/*</exclude-pattern>
	</rule>
	<rule ref="Generic.Commenting.DocComment.MissingShort">
		<exclude-pattern>/tests/php/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.Files.FileName">
		<exclude-pattern>/tests/php/*</exclude-pattern>
		<!-- block.json looks for index.asset.php by that exact name. -->
		<exclude-pattern>*.asset.php</exclude-pattern>
	</rule>
	<rule ref="WordPress.WP.AlternativeFunctions">
		<exclude-pattern>/tests/php/*</exclude-pattern>
	</rule>
	<rule ref="Universal.Operators.DisallowShortTernary">
		<exclude-pattern>/tests/php/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.Security.ValidatedSanitizedInput">
		<exclude-pattern>/tests/php/*</exclude-pattern>
	</rule>
	<!-- A test invokes core's own hooks and names its classes after what it tests. -->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<exclude-pattern>/tests/php/*</exclude-pattern>
	</rule>

	<!-- Fixture scripts are run with WP-CLI, not loaded by WordPress; they get the test rules. -->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<exclude-pattern>/packages/fixtures/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.WP.AlternativeFunctions">
		<exclude-pattern>/packages/fixtures/*</exclude-pattern>
	</rule>

	<!--
		wp-tests-config.php is a WordPress configuration file, not plugin code: every name in it —
		DB_NAME, ABSPATH, $table_prefix — is one core chose, so the prefix and global-override rules
		are asking it to be something it cannot be.
	-->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<exclude-pattern>/tests/php/wp-tests-config.php</exclude-pattern>
	</rule>
	<rule ref="WordPress.WP.GlobalVariablesOverride">
		<exclude-pattern>/tests/php/wp-tests-config.php</exclude-pattern>
	</rule>
</ruleset>
