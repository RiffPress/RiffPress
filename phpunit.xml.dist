<?xml version="1.0"?>
<!--
	The WordPress test suite, not a mocked stand-in: Riff's PHP is mostly a conversation with
	WordPress, and a test that mocks that conversation only proves the mock agrees with itself.
	Run it with `npm run test:php`, which runs this inside the tests container, where the repository
	is mounted at wp-content/riff.
-->
<phpunit
	bootstrap="plugins/riff/tests/php/bootstrap.php"
	backupGlobals="false"
	colors="true"
	beStrictAboutTestsThatDoNotTestAnything="true"
	convertDeprecationsToExceptions="true"
	failOnWarning="true"
	failOnRisky="true"
	>
	<testsuites>
		<testsuite name="riff">
			<directory suffix=".php">./plugins/riff/tests/php</directory>
			<exclude>./plugins/riff/tests/php/bootstrap.php</exclude>
		</testsuite>
	</testsuites>
</phpunit>
