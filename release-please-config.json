{
	"$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
	"release-type": "simple",
	"include-component-in-tag": false,
	"include-v-in-tag": true,
	"draft": true,
	"force-tag-creation": true,
	"separate-pull-requests": true,
	"bootstrap-sha": "b1f83e815a11cd938ae068d322b27980b821dd79",
	"pull-request-title-pattern": "chore${scope}: release ${component} ${version}",
	"changelog-sections": [
		{ "type": "feat",     "section": "Features" },
		{ "type": "fix",      "section": "Bug Fixes" },
		{ "type": "perf",     "section": "Performance Improvements" },
		{ "type": "revert",   "section": "Reverts" },
		{ "type": "build",    "section": "Dependencies" },
		{ "type": "docs",     "section": "Documentation",          "hidden": true },
		{ "type": "style",    "section": "Styles",                 "hidden": true },
		{ "type": "chore",    "section": "Miscellaneous Chores",   "hidden": true },
		{ "type": "refactor", "section": "Code Refactoring",       "hidden": true },
		{ "type": "test",     "section": "Tests",                  "hidden": true },
		{ "type": "ci",       "section": "Continuous Integration", "hidden": true }
	],
	"packages": {
		"plugins/riff": {
			"package-name": "riff",
			"component": "riff"
		},
		"plugins/riff-lyrics": {
			"package-name": "riff-lyrics",
			"component": "riff-lyrics",
			"include-component-in-tag": true,
			"initial-version": "0.1.0"
		},
		"packages/wp-api-coverage": {
			"package-name": "wp-api-coverage",
			"component": "wp-api-coverage",
			"include-component-in-tag": true,
			"initial-version": "0.1.0"
		}
	}
}
